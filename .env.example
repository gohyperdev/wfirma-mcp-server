# wFirma API Key authentication (required)
WFIRMA_ACCESS_KEY=your_access_key
WFIRMA_SECRET_KEY=your_secret_key
WFIRMA_APP_KEY=your_app_key

# Optional: company ID for multi-company accounts
# WFIRMA_COMPANY_ID=your_company_id

# MCP transport. Default is stdio. Use HTTP(S) for Codex's Streamable HTTP connection.
# MCP_TRANSPORT=https
# MCP_HOST=127.0.0.1
# MCP_PORT=3333
# MCP_PATH=/mcp

# Required only with MCP_TRANSPORT=https. Use absolute paths to a trusted local certificate and key.
# MCP_TLS_CERT_FILE=/absolute/path/to/localhost.pem
# MCP_TLS_KEY_FILE=/absolute/path/to/localhost-key.pem

# Optional defence-in-depth for a local HTTP(S) server. Configure the same value in Codex.
# MCP_AUTH_TOKEN=replace-with-a-long-random-value
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
